# KORA Docker Environment Configuration

# Ollama Configuration
# For host Ollama: use host.docker.internal:11434 (default)
# For containerized Ollama: use ollama:11434
# For remote Ollama: use http://your-server:11434
OLLAMA_HOST=http://host.docker.internal:11434

# Data directories (inside container)
KORA_DATA_DIR=/data
KORA_MODEL_DIR=/models

# Port mappings (host:container)
# Web interface
WEB_PORT=7860
ADMIN_PORT=7861

# API server
API_PORT=8000

# Database Configuration
# Use SQLite for local development (default)
DATABASE_URL=file:/data/kora.db

# Or use PostgreSQL for production (uncomment and configure)
# DATABASE_URL=postgresql://kora:kora_password@postgres:5432/kora

# PostgreSQL Settings (if using postgres service)
POSTGRES_DB=kora
POSTGRES_USER=kora
POSTGRES_PASSWORD=kora_password
POSTGRES_PORT=5432

# Logging Configuration
ENABLE_DB_LOGGING=true
